[submodule "libultraship"]
	path = libultraship
	# The fork, because the pinned commit carries the arm64 top-byte-ignore fix
	# that Android needs to render at all, and that is not upstream yet
	# (Kenix3/libultraship#1214). Point this back at Kenix3 once it merges.
	url = https://github.com/izzy2lost/libultraship.git
	branch = lighthouse-android-tbi-fix
[submodule "Torch"]
	path = Torch
	url = https://github.com/HarbourMasters/Torch.git
